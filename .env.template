# Configuración de Base de Datos PostgreSQL
DB_NAME=tranqui_app
DB_USER=tomaskimmel
DB_PASSWORD=securepassword

# Clave de Cifrado AES-256 (Debe tener exactamente 32 caracteres)
ENCRYPTION_KEY=masterdecryptionkey32charspart12

# Integración de WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

# Autenticación de Google (OAuth2 Client ID) - debe coincidir con el client_id hardcodeado
# en frontend/src/components/LoginPage.tsx (botón "Sign in with Google")
GOOGLE_CLIENT_ID=dummy-client-id
# Client Secret del mismo OAuth Client (Google Cloud Console > Credentials). Requerido para
# vincular Google Calendar (intercambio de authorization code por tokens).
GOOGLE_CLIENT_SECRET=
# Poné "true" solo cuando tengas client-id/secret reales y la Calendar API habilitada en el
# proyecto de Google Cloud. Activa la consulta de eventos reales (disponibilidad) y la
# creación de reuniones de Google Meet al confirmar un turno.
GOOGLE_CALENDAR_ENABLED=false

# Integración de Mercado Pago (OAuth Connect - cada profesional cobra 100% en su propia cuenta)
# Poné "true" solo cuando tengas credenciales reales y quieras probar/deployar contra la API real.
MERCADOPAGO_ENABLED=false
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Secret del webhook, se obtiene en el panel de la Aplicación de Mercado Pago (sección Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública HTTPS del BACKEND (usada para el redirect_uri de OAuth y el notification_url del webhook).
# En desarrollo, la URL que te da ngrok al tunelizar el puerto 8081. En producción, tu dominio real.
APP_PUBLIC_URL=http://localhost:8081

# URL pública del FRONTEND, a donde se redirige al profesional luego de vincular su cuenta.
FRONTEND_URL=http://localhost:5173
